{
  "manifest_version": 3,
  "name": "Sightline checkout guard (prototype)",
  "version": "0.1.0",
  "description": "Before you pay, reads back the total and payee, then asks for Confirm and your PIN. Prototype; no network calls.",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "Sightline checkout guard" },
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.paypal.com/checkoutnow*",
        "https://www.paypal.com/checkoutweb/*",
        "https://www.paypal.com/checkout/*",
        "https://www.paypal.com/webapps/*",
        "https://www.sandbox.paypal.com/checkoutnow*",
        "https://www.sandbox.paypal.com/checkoutweb/*",
        "https://www.sandbox.paypal.com/checkout/*",
        "https://www.sandbox.paypal.com/webapps/*"
      ],
      "js": ["detect.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dialog.html", "dialog.js", "pin.js", "ui.css"],
      "matches": ["https://*/*", "http://*/*"],
      "use_dynamic_url": true
    }
  ]
}
